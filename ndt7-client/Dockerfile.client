# ndt7-client container focused on single-shot measurements with log export.
FROM golang:1.20-alpine3.18 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/ndt7-client ./cmd/ndt7-client

FROM alpine:3.18
WORKDIR /app
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/ndt7-client /app/ndt7-client
COPY docker/ndt7-client-entrypoint.sh /usr/local/bin/ndt7-client-entrypoint.sh
RUN chmod +x /usr/local/bin/ndt7-client-entrypoint.sh
ENV LOG_DIR=/logs \
    EXPERIMENT=default \
    NDT7_SCHEME=ws \
    NDT7_SERVER=127.0.0.1:18080
VOLUME ["/logs"]
ENTRYPOINT ["ndt7-client-entrypoint.sh"]
